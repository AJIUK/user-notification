<?php

namespace App\Http\Resources;

use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\JsonResource;
use UserNotification\Contracts\NotificationChannelEnum;

/**
 * Ресурс для канала уведомления (NotificationChannelEnum)
 */
class UserNotificationChannelResource extends JsonResource
{
    /**
     * Преобразовать ресурс в массив
     *
     * @return array<string, mixed>
     */
    public function toArray(Request $request): array
    {
        /** @var NotificationChannelEnum $this */
        $user = $request->user();

        return [
            'id' => $this->getValue(),
            'code' => $this->getName(),
            'title' => $this->getTitle(),
            'sort' => $this->getSort(),
            'is_hidden' => $this->isHidden(),
            'is_connected' => $user ? $this->getChannel()->isAvailable($user) : null,
        ];
    }
}
